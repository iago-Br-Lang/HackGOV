# Generated by Cargo
# will have compiled files and executables
/target
.DS_Store

# These are backup files generated by rustfmt
**/*.rs.bk

# Node / Tailwind CLI
node_modules/
npm-debug.log*

# Dioxus build output
/dist

# Banco de dados local do backend (feature `server`), gerado em runtime
*.db
*.db-journal

# Backend Java (Maven)
/backend-java/target

# Scripts Python: dados fictícios e relatórios gerados (não versionar)
/scripts-python/data/
/scripts-python/output/
/scripts-python/__pycache__/
/scripts-python/**/__pycache__/
/scripts-python/.venv/
